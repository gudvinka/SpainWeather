{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(date *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "WebFetch(domain:www.hispacams.com)",
      "WebFetch(domain:rtsp.me)",
      "WebFetch(domain:webcam.meteo365.es)",
      "WebFetch(domain:www.meteobuenavista.es)",
      "WebFetch(domain:www.ugr.es)",
      "WebFetch(domain:api.open-meteo.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./dist/**)",
      "Read(./build/**)"
    ]
  }
}
